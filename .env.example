# ==============================================================================
# AIDE Environment Configuration Template
# Copy this file to .env before running the pipeline or starting the frontend.
# ==============================================================================

# --- Python AI Pipeline Secrets (Root .env) ---
# Supabase URL and Service Role Key (Keep private, used by pipeline script)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Gemini API Key for Article Scoring
GEMINI_API_KEY=your-gemini-api-key

# --- React Frontend Secrets (frontend/.env) ---
# Supabase URL and Public Anon Key (Safe for client browser)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-public-key
